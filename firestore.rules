rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: settings
    // Document ID: main
    // Fields: name, visitCount, teamMembers, businessHours, etc.
    //
    // Collection: services
    // Fields: name, price, duration, category, isVisible, etc.
    //
    // Collection: customers
    // Fields: name, whatsapp, cpf, password, history, etc.
    //
    // Collection: bookings
    // Fields: customerId, serviceId, dateTime, status, etc.
    //
    // Collection: transactions
    // Fields: type, amount, date, status, etc.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "Serginhoz12@gmail.com" && request.auth.token.email_verified == true) ||
          exists(/databases/$(database)/documents/admin_sessions/$(request.auth.uid))
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /admin_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == sessionId;
      allow delete: if isAuthenticated() && request.auth.uid == sessionId;
    }

    match /settings/main {
      allow read: if true;
      // Allow everyone to increment visitCount
      allow update: if true; 
      allow create, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      // Allow read for admin or the customer document itself (if we had a way to link them)
      // Since it's anonymous, we'll allow read if they know the ID for now, 
      // but ideally we'd restrict this.
      allow read: if true; 
      allow write: if true; // Allow registration
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true; // Allow booking
    }

    match /transactions/{transactionId} {
      // Allow read if authenticated to help recover "lost" data for anonymous admins
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /waitlist/{waitlistId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productInterests/{interestId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /productOrders/{orderId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && 
        (request.resource.data.role == 'client' || isAdmin());
      allow update: if isAdmin();
    }
  }
}
