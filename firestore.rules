rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: settings
    // Document ID: main
    // Fields: name, visitCount, teamMembers, businessHours, lastUpdated, etc.
    //
    // Collection: services
    // Fields: name, price, duration, category, isVisible, etc.
    //
    // Collection: customers
    // Fields: name, whatsapp, cpf, password, history, etc.
    //
    // Collection: bookings
    // Fields: customerId, serviceId, dateTime, status, etc.
    //
    // Collection: transactions
    // Fields: type, amount, date, status, etc.
    //
    // Collection: admin_sessions
    // Document ID: {userId}
    // Fields: authorizedAt, method
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBaseAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "Serginhoz12@gmail.com") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isAdmin() {
      return isBaseAdmin() || 
             (isAuthenticated() && exists(/databases/$(database)/documents/admin_sessions/$(request.auth.uid)));
    }

    // Validator for settings update (visit count only)
    function isValidSettingsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitCount', 'lastUpdated']) &&
             request.resource.data.visitCount == resource.data.visitCount + 1;
    }

    // Validator for customer data
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'whatsapp']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() < 30;
    }

    // Validator for bookings
    function isValidBooking(data) {
      return data.keys().hasAll(['customerId', 'serviceId', 'dateTime', 'status']) &&
             data.customerId is string &&
             data.serviceId is string &&
             data.dateTime is string &&
             data.status in ['pending', 'scheduled', 'completed', 'cancelled', 'blocked', 'open'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /admin_sessions/{sessionId} {
      allow read: if isOwner(sessionId) || isBaseAdmin();
      allow create, update: if isOwner(sessionId);
      allow delete: if isOwner(sessionId) || isBaseAdmin();
    }

    match /settings/main {
      allow read: if true; // Publicly readable for the site to work
      allow update: if isAdmin() || (isAuthenticated() && isValidSettingsUpdate());
      allow create, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || isOwner(customerId);
      allow create: if isAuthenticated() && isValidCustomer(request.resource.data);
      allow update: if isAdmin() || (isOwner(customerId) && isValidCustomer(request.resource.data));
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.customerId == request.auth.uid));
      allow create: if isAuthenticated() && isValidBooking(request.resource.data) && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid && isValidBooking(request.resource.data));
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /waitlist/{waitlistId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productInterests/{interestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /productOrders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAdmin();
    }
  }
}
