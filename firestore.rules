rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Base admin logic (Hardcoded owners)
    function isBaseAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email != null && 
           (request.auth.token.email.lower() == "serginhoz12@gmail.com")) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // Global Admin Check (Session based)
    function isAdmin() {
      return isBaseAdmin() || 
             (isAuthenticated() && exists(/databases/$(database)/documents/admin_sessions/$(request.auth.uid)));
    }

    // Validator for settings update (visit count only)
    function isValidSettingsUpdate() {
      return request.resource.data.keys().hasAll(['visitCount', 'lastUpdated']) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitCount', 'lastUpdated']) &&
             request.resource.data.visitCount == resource.data.visitCount + 1;
    }

    // Validator for customer data
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'whatsapp']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() < 30;
    }

    // Validator for bookings
    function isValidBooking(data) {
      return data.keys().hasAll(['customerId', 'serviceId', 'dateTime', 'status']) &&
             data.customerId is string &&
             data.serviceId is string &&
             data.dateTime is string &&
             data.status in ['pending', 'scheduled', 'completed', 'cancelled', 'blocked', 'open'];
    }

    // Validator for promotions
    function isValidPromotion(data) {
      return data.keys().hasAll(['title', 'content', 'type', 'isActive']) &&
             data.title is string && data.title.size() > 0 &&
             data.content is string && data.content.size() > 0 &&
             data.type in ['promotion', 'tip'];
    }

    // ===============================================================
    // Rules per Collection
    // ===============================================================

    match /admin_sessions/{sessionId} {
      allow read: if isOwner(sessionId) || isBaseAdmin();
      // Allow creation via secret passcode to authorize any authenticated user as admin
      allow create: if isOwner(sessionId) && 
                    request.resource.data.passcode == '460206' &&
                    request.resource.data.authorizedAt is string;
      allow update, delete: if isOwner(sessionId) || isBaseAdmin();
    }

    match /settings/main {
      allow read: if true;
      allow update: if isAdmin() || (isAuthenticated() && isValidSettingsUpdate());
      allow create, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      // Secure list query enforcement: admins list all, others list only their own
      allow read: if isAdmin() || isOwner(customerId);
      allow create: if isAuthenticated() && isValidCustomer(request.resource.data) && isOwner(customerId);
      allow update: if isAdmin() || (isOwner(customerId) && isValidCustomer(request.resource.data));
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Secure list query enforcement
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.customerId == request.auth.uid));
      allow create: if isAuthenticated() && isValidBooking(request.resource.data) && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid && isValidBooking(request.resource.data));
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /waitlist/{waitlistId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPromotion(request.resource.data);
      allow update: if isAdmin() && (resource == null || isValidPromotion(request.resource.data));
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productInterests/{interestId} {
      allow read: if isAdmin();
      // Allow customers to see their own if customerId is present (optional enhancement)
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /productOrders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.customerId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAdmin();
    }
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
